# ═══════════════════════════════════════════════════════════════
#  AIRA - Configuración
#  Copia este archivo como .env y rellena los valores
# ═══════════════════════════════════════════════════════════════

# ── Anthropic API ─────────────────────────────────────────────
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Vault de Obsidian ─────────────────────────────────────────
# Windows (sin WSL): usa barras / no \
# Ejemplo: C:/Users/TuUsuario/Documents/TuVault
VAULT_PATH=C:/Users/Cliente/Documents/ObsidianVault

# ── Telegram ──────────────────────────────────────────────────
# Para obtener tu Chat ID: escríbele a @userinfobot en Telegram
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ── Ollama ────────────────────────────────────────────────────
# NO cambies esto si usas Windows con Docker Desktop
OLLAMA_HOST=http://host.docker.internal:11434
