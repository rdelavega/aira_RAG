# ═══════════════════════════════════════════════════════════════
#  AIRA - Configuración
#  Copia este archivo como .env y rellena los valores
#  Este es el ÚNICO archivo que necesitas editar.
# ═══════════════════════════════════════════════════════════════

# ── Anthropic API ─────────────────────────────────────────────
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Vault de Obsidian ─────────────────────────────────────────
# Windows: usa barras / no \
# Ejemplo: C:/Users/TuUsuario/Documents/TuVault
VAULT_PATH=C:/Users/Cliente/Documents/ObsidianVault

# ── Telegram ──────────────────────────────────────────────────
# Bot token: lo recibes del desarrollador junto con esta carpeta
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui

# IDs de Telegram autorizados (separados por coma, sin espacios)
# Escríbele a @userinfobot para obtener tu ID
# Dejar vacío = cualquiera puede usar el bot (no recomendado)
ALLOWED_USER_IDS=123456789

# ── Ollama ────────────────────────────────────────────────────
# NO cambies esto si usas Windows con Docker Desktop
OLLAMA_HOST=http://host.docker.internal:11434

# ── Proveedor de análisis de PDFs ─────────────────────────────
# anthropic → usa Claude (requiere créditos, mayor calidad)
# ollama    → usa modelo local (sin costo, más lento y menor calidad)
ANALYSIS_PROVIDER=anthropic

# ── Modelo del agente (conversaciones en Telegram) ────────────
# anthropic/claude-haiku-4-5  → Claude API (requiere créditos, respuestas en <5s)
# ollama/llama3.2:1b           → local sin GPU, ~20-40s/resp  ← recomendado para pruebas
# ollama/llama3.2:3b           → local sin GPU, puede superar el timeout de 2min
# ollama/qwen2.5:3b            → local sin GPU, puede superar el timeout de 2min
AGENT_MODEL=anthropic/claude-haiku-4-5

# ── Historial de conversación ─────────────────────────────────
# Número de intercambios que recuerda Aira por sesión.
# Más turnos = mejor memoria, más tokens por llamada.
# 5 turnos ≈ costo fijo de ~3,500 tokens/mensaje (predecible)
# 10 turnos ≈ costo fijo de ~6,000 tokens/mensaje
MAX_HISTORY_TURNS=5
